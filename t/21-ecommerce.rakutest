use Test;
use Sourcing;
use Sourcing::Plugin::Memory;

# Exercises the e-commerce example modules *directly* (loading the real files
# under examples/ecommerce/lib), as opposed to t/16 which reimplements the same
# concepts inline. This keeps the shipped example honest: if an aggregate,
# projection, or the fulfillment saga regresses, this test fails.
use lib 'examples/ecommerce/lib';
use Sourcing::Example::Ecommerce::Events;
use Sourcing::Example::Ecommerce::OrderAggregate;
use Sourcing::Example::Ecommerce::InventoryAggregate;
use Sourcing::Example::Ecommerce::PaymentAggregate;
use Sourcing::Example::Ecommerce::OrderProjection;
use Sourcing::Example::Ecommerce::InventoryProjection;
use Sourcing::Example::Ecommerce::PaymentProjection;
use Sourcing::Example::Ecommerce::OrderFulfillmentSaga;

plan 6;

sub reset() { Sourcing::Plugin::Memory.use }

# Event-driven dispatch: rebuild the saga from history, apply the new event live,
# then persist it so later reconstructions replay it (and rebuild the anti-event
# compensation queue). Returns the saga so callers can read its state.
sub dispatch(Str $saga-id, $event) {
    my $s = sourcing Sourcing::Example::Ecommerce::OrderFulfillmentSaga, :$saga-id;
    $s.apply($event);
    $*SourcingConfig.emit: $event;
    $s
}

# Short aliases for the long namespaced types.
constant Order     = Sourcing::Example::Ecommerce::OrderAggregate;
constant Inventory = Sourcing::Example::Ecommerce::InventoryAggregate;
constant Payment   = Sourcing::Example::Ecommerce::PaymentAggregate;
constant OrderView = Sourcing::Example::Ecommerce::OrderProjection;
constant Saga      = Sourcing::Example::Ecommerce::OrderFulfillmentSaga;

subtest 'OrderAggregate — create, submit, total' => {
    reset();

    my $order = sourcing Order, :order-id<O1>;
    $order.create-order:
        :customer-id<C1>,
        :items({ WIDGET => { :quantity(2), :unit-price(9.99) } });

    my $o1 = sourcing Order, :order-id<O1>;
    is $o1.status, 'pending', 'order is pending after create';
    is $o1.total, 19.98, 'total is quantity × unit-price';

    $o1.submit;
    is (sourcing Order, :order-id<O1>).status, 'submitted', 'order is submitted';
};

subtest 'InventoryAggregate — adjust and reserve' => {
    reset();

    my $inv = sourcing Inventory, :item-id<WIDGET>;
    $inv.adjust: :quantity-change(10), :reason<initial-stock>;
    is (sourcing Inventory, :item-id<WIDGET>).total-available, 10, 'stock added';

    my $inv2 = sourcing Inventory, :item-id<WIDGET>;
    $inv2.reserve: :order-id<O1>, :quantity(3);

    my $inv3 = sourcing Inventory, :item-id<WIDGET>;
    is $inv3.reserved, 3, 'three units reserved';
    is $inv3.total-available, 7, 'available reduced by reservation';

    $inv3.release: :order-id<O1>;
    my $inv4 = sourcing Inventory, :item-id<WIDGET>;
    is $inv4.reserved, 0, 'reservation released';
    is $inv4.total-available, 10, 'availability restored';
};

subtest 'PaymentAggregate — initiate, authorize, capture' => {
    reset();

    my $pay = sourcing Payment, :payment-id<P1>;
    $pay.initiate: :order-id<O1>, :amount(50.0), :method<credit-card>;
    is (sourcing Payment, :payment-id<P1>).status, 'pending', 'payment pending after initiate';

    my $p2 = sourcing Payment, :payment-id<P1>;
    $p2.authorize: :authorization-code<AUTH-1>;
    is (sourcing Payment, :payment-id<P1>).status, 'authorized', 'payment authorized';

    my $p3 = sourcing Payment, :payment-id<P1>;
    $p3.capture: :captured-amount(50.0);
    my $p4 = sourcing Payment, :payment-id<P1>;
    is $p4.status, 'captured', 'payment captured';
    is $p4.captured-amount, 50.0, 'captured amount recorded';
};

subtest 'OrderProjection — read model tracks order status' => {
    reset();

    my $order = sourcing Order, :order-id<O5>;
    $order.create-order:
        :customer-id<C5>,
        :items({ GADGET => { :quantity(1), :unit-price(12.50) } });

    my $view = sourcing OrderView, :order-id<O5>;
    is $view.status, 'pending', 'projection sees pending order';
    is $view.customer-id, 'C5', 'projection captured customer';
};

subtest 'OrderFulfillmentSaga — happy path fulfils the order' => {
    reset();

    # Stock + submitted order are preconditions for fulfillment.
    my $inv = sourcing Inventory, :item-id<WIDGET>;
    $inv.adjust: :quantity-change(10), :reason<initial-stock>;

    my $order = sourcing Order, :order-id<O1>;
    $order.create-order:
        :customer-id<C1>,
        :items({ WIDGET => { :quantity(2), :unit-price(9.99) } });
    $order.submit;

    # Drive the saga by events: reserve + pay, then confirm to complete the order.
    my $saga = dispatch 'S1', FulfillmentRequested.new(
        :saga-id<S1>, :order-id<O1>, :item-id<WIDGET>, :quantity(2), :amount(19.98));
    is $saga.state, 'fulfilled', 'saga reaches fulfilled';
    is (sourcing Order, :order-id<O1>).status, 'submitted', 'order stays submitted (reversible)';

    my $inv-after = sourcing Inventory, :item-id<WIDGET>;
    is $inv-after.reserved, 2, 'stock remains reserved for fulfilled order';
    is $inv-after.total-available, 8, 'available stock reduced';

    is (sourcing Payment, :payment-id<pay-O1>).status, 'captured',
        'payment ends captured';

    $saga = dispatch 'S1', FulfillmentConfirmed.new(:saga-id<S1>, :order-id<O1>);
    is $saga.state, 'completed', 'saga completes on confirmation';
    is (sourcing Order, :order-id<O1>).status, 'completed', 'order is completed';
};

subtest 'OrderFulfillmentSaga — cancellation rolls back via anti-events' => {
    reset();

    my $inv = sourcing Inventory, :item-id<GADGET>;
    $inv.adjust: :quantity-change(5), :reason<initial-stock>;

    my $order = sourcing Order, :order-id<O2>;
    $order.create-order:
        :customer-id<C2>,
        :items({ GADGET => { :quantity(3), :unit-price(5.0) } });
    $order.submit;

    # Fulfil, then cancel — the queued anti-events reverse every step.
    dispatch 'S2', FulfillmentRequested.new(
        :saga-id<S2>, :order-id<O2>, :item-id<GADGET>, :quantity(3), :amount(15.0));
    is (sourcing Inventory, :item-id<GADGET>).reserved, 3, 'stock reserved before cancel';

    my $saga = dispatch 'S2', FulfillmentCancelled.new(:saga-id<S2>);
    is $saga.state, 'cancelled', 'saga is cancelled';

    is (sourcing Order, :order-id<O2>).status, 'cancelled', 'order cancelled by rollback';

    my $inv-after = sourcing Inventory, :item-id<GADGET>;
    is $inv-after.reserved, 0, 'no stock left reserved after rollback';
    is $inv-after.total-available, 5, 'stock fully restored after rollback';

    is (sourcing Payment, :payment-id<pay-O2>).status, 'refunded',
        'payment refunded by rollback';
};

done-testing;
